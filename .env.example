# O banco local é configurado automaticamente em .local/database.json.
# Não são necessárias chaves Supabase.
# Integrações externas ficam desativadas para permitir uso offline.
ALLOW_ONLINE_INTEGRATIONS=false

# Opcionais, apenas se habilitar integrações com internet:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# TRELLO_BOARD_ID=
# TRELLO_LIST_ABERTA=